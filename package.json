{
  "description": "A foundation for scalable desktop apps",
  "keywords": [
    "electron",
    "boilerplate",
    "react",
    "typescript",
    "ts",
    "sass",
    "webpack",
    "hot",
    "reload"
  ],
  "homepage": "https://github.com/electron-react-boilerplate/electron-react-boilerplate#readme",
  "bugs": {
    "url": "https://github.com/electron-react-boilerplate/electron-react-boilerplate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electron-react-boilerplate/electron-react-boilerplate.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Sigma Technologies Ltd",
    "email": "contact@onepad.io",
    "url": "https://sigma-tech.co.uk"
  },
  "main": "./release/app/dist/main/main.js",
  "scripts": {
    "clean": "rimraf release/app/dist node_modules/.vite",
    "build": "npm run clean && electron-vite build",
    "build:main": "electron-vite build --main",
    "build:renderer": "electron-vite build --renderer",
    "postinstall": "electron-builder install-app-deps",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
    "package": "npm run build && electron-builder build --publish never",
    "package:all": "npm run build && electron-builder -mwl --x64 --publish never",
    "package:mac": "npm run build && electron-builder -m --x64 --publish never",
    "package:win": "npm run build && electron-builder -w --x64 --publish never",
    "package:linux": "npm run build && electron-builder -l --x64 --publish never",
    "publish:mac": "electron-builder -m --x64 --arm64 --publish always",
    "publish:win": "electron-builder -w --x64 --publish always",
    "publish:linux": "electron-builder -l --x64 --publish always",
    "package-publish:mac": "npm run build && electron-builder -m --x64 --publish always",
    "package-publish:win": "npm run build && electron-builder -w --x64 --publish always",
    "package-publish:linux": "npm run build && electron-builder -l --x64 --publish always",
    "package-publish:all": "npm run build && electron-builder -mwl --x64 --publish always",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "dev:kiosk": "electron-vite dev -- --kiosk",
    "preview": "electron-vite preview",
    "test": "jest"
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      ".erb/dll"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-brands-svg-icons": "^6.2.1",
    "@fortawesome/free-regular-svg-icons": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@popperjs/core": "^2.11.6",
    "@reduxjs/toolkit": "^1.9.1",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.1.3",
    "bootstrap": "^5.2.2",
    "clsx": "^1.2.1",
    "crypto-js": "^4.1.1",
    "dexie": "^3.2.2",
    "dexie-observable": "^4.0.1-beta.13",
    "dexie-react-hooks": "^1.1.1",
    "docker-cli-js": "^2.10.0",
    "electron-context-menu": "^3.6.1",
    "electron-debug": "^3.2.0",
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0",
    "electron-updater": "^5.3.0",
    "electron-util": "^0.17.2",
    "favicon-getter": "^1.1.3",
    "gsap": "^3.12.2",
    "hotkey-listener": "^0.0.6",
    "intro.js": "^6.0.0",
    "intro.js-react": "^0.7.1",
    "is-electron": "^2.2.1",
    "is-url": "^1.2.4",
    "is-url-http": "^2.3.13",
    "lodash": "^4.17.21",
    "loglevel": "^1.8.1",
    "pexels": "^1.4.0",
    "react": "^18.2.0",
    "react-arborist": "^3.0.2",
    "react-bootstrap-icons": "^1.10.2",
    "react-calendar": "^5.0.0",
    "react-clock": "^5.0.0",
    "react-contexify": "^6.0.0",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-globe.gl": "^2.25.0",
    "react-grid-layout": "^1.4.4",
    "react-konva": "^18.2.10",
    "react-osx-dock": "^1.0.0",
    "react-papaparse": "^4.4.0",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.8.0",
    "react-svg": "^16.1.34",
    "react-switch": "^7.0.0",
    "react-tabs": "^6.0.0",
    "react-top-loading-bar": "^2.3.1",
    "react-use-websocket": "^4.7.0",
    "reactstrap": "^9.1.5",
    "redux": "^4.2.0",
    "socket.io-client": "^4.7.4",
    "split-pane-react": "^0.1.3",
    "tailwindcss": "^3.2.4",
    "uuid": "^10.0.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@electron/notarize": "^1.2.3",
    "@electron/rebuild": "^3.2.10",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.4.0",
    "@types/node": "18.11.19",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-test-renderer": "^18.0.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^7.6.0",
    "core-js": "^3.27.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^3.2.0",
    "electron-vite": "^2.3.0",
    "eslint": "^8.33.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-erb": "^4.0.5",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-compat": "^4.0.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "node-abi": "^3.65.0",
    "postcss": "^8.5.6",
    "prettier": "^2.8.3",
    "react-refresh": "^0.14.0",
    "react-scripts": "5.0.1",
    "react-test-renderer": "^18.2.0",
    "rimraf": "^4.1.2",
    "sass": "^1.58.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "vite": "^5.4.11",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "build": {
    "productName": "OnePad",
    "appId": "com.sigma.onepad",
    "asar": true,
    "asarUnpack": "**/*.{node,dll,png,jpg,jpeg,gif,svg,ico,webp}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "extraMetadata": {
      "main": "./dist/main/main.js"
    },
    "afterSign": ".erb/scripts/notarize.js",
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "mac": {
      "notarize": false,
      "target": [
        {
          "target": "pkg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Please give us access to your microphone",
        "NSCameraUsageDescription": "Please give us access to your camera",
        "NSScreenCaptureUsageDescription": "Please give us access to your screen",
        "NSAppleEventsUsageDescription": "Please give us access to your Apple Events"
      },
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "s3",
      "bucket": "onepad",
      "endpoint": "https://lon1.digitaloceanspaces.com",
      "region": "lon1",
      "channel": "beta",
      "path": "beta",
      "acl": "public-read"
    },
    "generateUpdatesFilesForAllChannels": false
  },
  "collective": {
    "url": "https://opencollective.com/electron-react-boilerplate-594"
  },
  "devEngines": {
    "node": ">=14.x",
    "npm": ">=7.x"
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**"
    ],
    "logLevel": "quiet"
  }
}
